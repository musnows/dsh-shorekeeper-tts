{
  "name": "@dsh-local/shorekeeper-tts",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "用守岸人音色朗读 DeepSeek Harness 屏幕上的正文。",
  "main": "./plugin.mjs",
  "exports": {
    ".": "./plugin.mjs",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin.mjs",
    "pet-settings.mjs",
    "client.js",
    "stop-hotkey.swift",
    "locale",
    "realtime-demo"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  }
}
